# API Cyber - Environment Configuration

# Application
APP_NAME=api_cyber
DEBUG=false
ROOT_PATH=/cyber

# Database PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/api_cyber

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Agent API Key (for agents to authenticate)
AGENT_API_KEY=your-agent-api-key-change-in-production

# SMTP (Email Reports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_TO=admin@example.com

# LLM (Auto-explanations)
LLM_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
